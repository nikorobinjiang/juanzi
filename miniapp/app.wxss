page {
  --primary: #7c3aed;
  --primary-light: #a78bfa;
  --primary-deep: #6d28d9;
  --bg: #f5f6fa;
  --card: #ffffff;
  --text: #1f2937;
  --muted: #6b7280;
  --success: #10b981;
  --warning: #f59e0b;
  --danger: #ef4444;
  background: var(--bg);
  color: var(--text);
  font-family: "PingFang SC", -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

.page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
  animation: page-fade-in 0.3s ease both;
}

@keyframes page-fade-in {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(124, 58, 237, 0.06);
}

.card-tight {
  padding: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  margin: 8rpx 0 24rpx;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: "";
  width: 8rpx;
  height: 32rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  background: linear-gradient(180deg, var(--primary-light), var(--primary));
}

.muted {
  color: var(--muted);
  font-size: 26rpx;
}

.primary-btn,
.secondary-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  transition: transform 0.18s ease, opacity 0.18s ease, box-shadow 0.18s ease;
}

.primary-btn {
  color: #fff;
  background: linear-gradient(135deg, var(--primary-light) 0%, var(--primary) 55%, var(--primary-deep) 100%);
  box-shadow: 0 16rpx 36rpx rgba(124, 58, 237, 0.28);
  border: none;
}

.primary-btn::after,
.secondary-btn::after {
  border: none;
}

.primary-btn:active,
.secondary-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.secondary-btn {
  color: var(--primary);
  background: #f3efff;
  border: 1rpx solid rgba(124, 58, 237, 0.16);
}

.field {
  margin-bottom: 28rpx;
}

.field-label {
  font-size: 26rpx;
  color: var(--muted);
  margin-bottom: 12rpx;
}

.field-input,
.field-textarea,
.field-picker {
  width: 100%;
  min-height: 88rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  background: #f9fafb;
  border: 1rpx solid #eef0f4;
  border-radius: 18rpx;
  color: var(--text);
  font-size: 28rpx;
  transition: border-color 0.2s ease, background 0.2s ease;
}

.field-input:focus,
.field-textarea:focus {
  background: #fff;
  border-color: var(--primary-light);
}

.field-textarea {
  min-height: 180rpx;
}

.field-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field-picker .placeholder {
  color: #9ca3af;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(16rpx);
  box-shadow: 0 -8rpx 32rpx rgba(31, 41, 55, 0.06);
  z-index: 20;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  background: #f3efff;
  color: var(--primary);
}

.empty {
  padding: 100rpx 32rpx;
  text-align: center;
  color: var(--muted);
}

.empty-title {
  font-size: 30rpx;
  color: var(--text);
  margin-bottom: 12rpx;
}
