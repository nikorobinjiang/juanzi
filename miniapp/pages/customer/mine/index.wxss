.mine-page {
  padding-bottom: 48rpx;
}

.mine-header {
  padding: 24rpx 8rpx 32rpx;
  background: linear-gradient(135deg, #ede9fe, #f5f6fa);
  border-radius: 28rpx;
  margin-bottom: 24rpx;
}

.mine-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #4c1d95;
}

.mine-subtitle {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #7c3aed;
  opacity: 0.8;
}

.filter-bar {
  display: flex;
  padding: 8rpx;
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.04);
}

.filter-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #6b7280;
  border-radius: 18rpx;
  transition: all 0.2s ease;
}

.filter-item.active {
  color: #7c3aed;
  background: #f3efff;
  font-weight: 600;
}

.signup-card {
  padding: 24rpx;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.tag.cancelled {
  background: #f3f4f6;
  color: #6b7280;
}

.tag.joined {
  background: #ecfdf5;
  color: #059669;
}

.signup-time {
  font-size: 22rpx;
  color: #9ca3af;
}

.course-row {
  display: flex;
  align-items: center;
}

.course-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 18rpx;
  background: #ede9fe;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.course-main {
  flex: 1;
  min-width: 0;
}

.course-title {
  font-size: 30rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-meta,
.course-progress {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9ca3af;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-progress {
  color: #7c3aed;
}

.course-arrow {
  font-size: 48rpx;
  color: #d1d5db;
  margin-left: 12rpx;
}

.card-actions {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f3f4f6;
  display: flex;
  justify-content: flex-end;
}

.cancel-btn {
  font-size: 24rpx;
  color: #ef4444;
  background: #fff1f2;
  border-radius: 24rpx;
  padding: 12rpx 28rpx;
  border: none;
}

.cancel-btn::after {
  border: none;
}

.empty-btn {
  width: 60%;
  margin: 36rpx auto 0;
}

.loading-view { padding: 8rpx 0; }
.skeleton {
  height: 180rpx;
  border-radius: 24rpx;
  background: linear-gradient(90deg, #eef0f4 25%, #f8fafc 50%, #eef0f4 75%);
  background-size: 400% 100%;
  animation: shimmer 1.4s ease infinite;
  margin-bottom: 24rpx;
}
@keyframes shimmer {
  0% { background-position: 100% 0; }
  100% { background-position: 0 0; }
}
