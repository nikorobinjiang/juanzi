.staff-page {
  padding-bottom: 48rpx;
}

.staff-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 8rpx 32rpx;
}

.staff-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #1f2937;
}

.staff-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.staff-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #a78bfa, #7c3aed);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 28rpx rgba(124, 58, 237, 0.24);
}

.create-btn {
  margin-bottom: 28rpx;
}

.activity-card {
  padding: 24rpx;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.tag.draft { background: #f3f4f6; color: #6b7280; }
.tag.published { background: #ecfdf5; color: #059669; }
.tag.ended { background: #fff7ed; color: #f59e0b; }
.tag.cancelled { background: #fff1f2; color: #ef4444; }

.activity-date {
  font-size: 22rpx;
  color: #9ca3af;
}

.activity-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

.activity-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

.progress-line {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.progress-track {
  flex: 1;
  height: 12rpx;
  border-radius: 12rpx;
  background: #ede9fe;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #a78bfa, #7c3aed);
  transition: width 0.5s ease;
}

.progress-text {
  margin-left: 20rpx;
  font-size: 24rpx;
  color: #7c3aed;
  flex-shrink: 0;
}

.card-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f3f4f6;
}

.action {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 24rpx;
  color: #6b7280;
  background: #f9fafb;
  border-radius: 18rpx;
  transition: all 0.18s ease;
}

.action:active {
  transform: scale(0.96);
}

.action.primary {
  color: #fff;
  background: linear-gradient(135deg, #a78bfa, #7c3aed);
}

.loading-view { padding: 8rpx 0; }
.skeleton {
  height: 220rpx;
  border-radius: 24rpx;
  background: linear-gradient(90deg, #eef0f4 25%, #f8fafc 50%, #eef0f4 75%);
  background-size: 400% 100%;
  animation: shimmer 1.4s ease infinite;
  margin-bottom: 24rpx;
}
@keyframes shimmer {
  0% { background-position: 100% 0; }
  100% { background-position: 0 0; }
}
