.create-page {
  padding-bottom: 200rpx;
}

.create-hero {
  padding: 24rpx 8rpx 32rpx;
}

.create-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #1f2937;
}

.create-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.upload-box {
  width: 100%;
  height: 260rpx;
  border: 2rpx dashed #d8b4fe;
  border-radius: 20rpx;
  overflow: hidden;
  background: #faf5ff;
}

.upload-preview {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #7c3aed;
  font-size: 26rpx;
}

.upload-icon {
  font-size: 56rpx;
  line-height: 1;
  margin-bottom: 12rpx;
}

.upload-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.datetime-row {
  display: flex;
  gap: 16rpx;
}

.picker-half {
  flex: 1;
  min-height: 80rpx;
  display: flex;
  align-items: center;
  font-size: 26rpx;
}

.create-actions {
  display: flex;
  gap: 20rpx;
}

.create-actions .secondary-btn {
  width: 32%;
}

.create-actions .primary-btn {
  flex: 1;
}
