.poster-page {
  padding-bottom: 64rpx;
}

.poster-tip {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ede9fe, #f5f3ff);
  margin-bottom: 28rpx;
}

.tip-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #a78bfa, #7c3aed);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  box-shadow: 0 10rpx 24rpx rgba(124, 58, 237, 0.22);
}

.tip-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #4c1d95;
}

.tip-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #7c3aed;
  opacity: 0.85;
}

.canvas-wrap {
  position: relative;
  width: 600rpx;
  height: 900rpx;
  margin: 0 auto;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 60rpx rgba(76, 29, 149, 0.18);
}

.poster-canvas {
  width: 600rpx;
  height: 900rpx;
}

.canvas-loading {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.92);
  color: #7c3aed;
  font-size: 26rpx;
}

.poster-actions {
  margin-top: 36rpx;
}

.action-row {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.action-row .secondary-btn {
  flex: 1;
}

.poster-hint {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.6;
}
