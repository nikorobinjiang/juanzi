<view class="page login-page">
  <view class="hero">
    <view class="hero-badge">YUEKE · GROUP COURSE</view>
    <view class="hero-title">一起拼课</view>
    <view class="hero-subtitle">找到同伴，让每一节课都更值得</view>
    <view class="hero-glow"></view>
  </view>

  <view class="card role-card">
    <view class="segment">
      <view class="segment-item {{tab === 'staff' ? 'active' : ''}}" data-tab="staff" bindtap="switchTab">机构人员</view>
      <view class="segment-item {{tab === 'customer' ? 'active' : ''}}" data-tab="customer" bindtap="switchTab">客户登录</view>
    </view>

    <view wx:if="{{tab === 'staff'}}" class="form">
      <view class="field">
        <view class="field-label">所属机构</view>
        <picker mode="selector" range="{{organizations}}" range-key="name" bindchange="onOrgChange">
          <view class="field-picker">
            <text class="{{orgIndex >= 0 ? '' : 'placeholder'}}">{{orgIndex >= 0 ? organizations[orgIndex].name : '请选择机构名称'}}</text>
            <text class="arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="field">
        <view class="field-label">用户名</view>
        <input class="field-input" data-field="username" value="{{username}}" bindinput="onInput" placeholder="请输入用户名" />
      </view>

      <view class="field">
        <view class="field-label">密码</view>
        <input class="field-input" data-field="password" value="{{password}}" bindinput="onInput" password placeholder="请输入密码" />
      </view>

      <t-button theme="primary" block loading="{{loading}}" bindtap="staffLogin">机构人员登录</t-button>
      <view class="hint">使用现有约课系统的机构账号登录，可在小程序内创建和分享拼课。</view>
    </view>

    <view wx:else class="form">
      <view class="field">
        <view class="field-label">昵称（选填）</view>
        <input class="field-input" data-field="name" value="{{name}}" bindinput="onInput" placeholder="用于活动报名展示" />
      </view>

      <view class="field">
        <view class="field-label">手机号（授权失败时填写）</view>
        <input class="field-input" data-field="phone" value="{{phone}}" bindinput="onInput" type="number" maxlength="11" placeholder="请输入 11 位手机号" />
      </view>

      <button class="primary-btn wechat-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber" loading="{{loading}}">
        微信一键登录
      </button>
      <view class="divider"><text>或</text></view>
      <button class="secondary-btn" bindtap="manualLogin" loading="{{loading}}">使用填写手机号登录</button>
      <view class="hint">手机号用于关联您的拼课记录，不会公开展示完整号码。</view>
    </view>
  </view>
</view>
