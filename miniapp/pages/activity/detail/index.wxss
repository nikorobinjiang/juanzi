.detail-page {
  padding-bottom: 200rpx;
}

.info-card {
  padding: 12rpx 32rpx;
}

.info-row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
  transition: opacity 0.2s ease;
}

.info-row:last-child {
  border-bottom: none;
}

.info-row:active {
  opacity: 0.65;
}

.info-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #7c3aed;
  background: #f3efff;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.info-icon.phone {
  color: #0ea5e9;
  background: #eaf6ff;
}

.info-icon.address {
  color: #f59e0b;
  background: #fff7e6;
}

.info-content {
  flex: 1;
  min-width: 0;
}

.info-label {
  font-size: 24rpx;
  color: #9ca3af;
  margin-bottom: 4rpx;
}

.info-value {
  font-size: 28rpx;
  color: #1f2937;
  line-height: 1.45;
  word-break: break-all;
}

.phone-value {
  color: #2563eb;
  font-weight: 500;
}

.info-action {
  font-size: 24rpx;
  color: #9ca3af;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.signup-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.signup-title {
  font-size: 36rpx;
  font-weight: 600;
}

.tag.full {
  background: #fff1f2;
  color: #ef4444;
}

.progress-track {
  height: 12rpx;
  border-radius: 12rpx;
  background: #ede9fe;
  overflow: hidden;
  margin-bottom: 32rpx;
}

.progress-fill {
  height: 100%;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #a78bfa, #7c3aed);
  transition: width 0.5s cubic-bezier(0.22, 1, 0.36, 1);
}

.signup-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.signup-item:last-child {
  border-bottom: none;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #c4b5fd, #8b5cf6);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  margin-right: 24rpx;
  flex-shrink: 0;
  box-shadow: 0 8rpx 20rpx rgba(124, 58, 237, 0.18);
}

.signup-main {
  flex: 1;
  min-width: 0;
}

.signup-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1f2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.signup-sub {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

.recent {
  font-size: 24rpx;
  color: #9ca3af;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.empty-inline {
  padding: 32rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #9ca3af;
}

.intro-text {
  font-size: 28rpx;
  color: #4b5563;
  line-height: 1.8;
}

.meta-row {
  display: flex;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f3f4f6;
  font-size: 26rpx;
}

.meta-label {
  color: #9ca3af;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.meta-value {
  color: #4b5563;
}

.detail-actions {
  display: flex;
  gap: 20rpx;
}

.detail-actions .secondary-btn {
  width: 34%;
}

.detail-actions .primary-btn {
  flex: 1;
}

.loading-view {
  padding: 32rpx;
}

.skeleton {
  height: 120rpx;
  border-radius: 24rpx;
  background: linear-gradient(90deg, #eef0f4 25%, #f8fafc 50%, #eef0f4 75%);
  background-size: 400% 100%;
  animation: shimmer 1.4s ease infinite;
  margin-bottom: 24rpx;
}

.skeleton-lg { height: 260rpx; }
.skeleton-sm { width: 60%; }

@keyframes shimmer {
  0% { background-position: 100% 0; }
  100% { background-position: 0 0; }
}
