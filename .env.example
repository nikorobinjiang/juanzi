APP_NAME="好运爆棚"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_CN
APP_TIMEZONE=Asia/Shanghai

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=juanzi
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ===== 微信认证服务号配置（明日上课提醒） =====
# 公众平台 → 设置与开发 → 基本配置
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 模板消息 ID（公众号后台 → 模板消息）；教练模板不填则回退到学员模板
WECHAT_TEMPLATE_ID=
WECHAT_COACH_TEMPLATE_ID=
# 每天几点推送次日课程（Asia/Shanghai），需服务器配置 schedule:run 的 cron
WECHAT_REMIND_TIME=20:00
# 学员端 / 教练端提醒总开关，默认关闭，确认模板可用后再打开
WECHAT_REMIND_ENABLED=false
WECHAT_COACH_REMIND_ENABLED=false
# true = 学员每节课一条，false = 按学员汇总成一条（教练端始终汇总）
WECHAT_REMIND_PER_LESSON=false
# 网页授权域名必须配置为 APP_URL 的域名，且校验文件放到 public/ 下
WECHAT_OAUTH_SCOPES=snsapi_base
# 服务器配置（接收消息推送）用的 Token，不用该功能可留空
WECHAT_SERVER_TOKEN=

# ===== 豆包(火山方舟 Ark)配置 =====
DOUBAO_API_KEY=
DOUBAO_CHAT_MODEL=doubao-seed-1-6-250615
DOUBAO_VISION_MODEL=doubao-seed-1-6-250615
DOUBAO_IMAGE_MODEL=doubao-seedream-3-0-i2i-250528
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 风格模板图（不填则用 public/styles/ 下的 style_a.jpg / style_b.jpg）
# DOUBAO_STYLE_A_IMAGE=https://your-domain/styles/style_a.jpg
# DOUBAO_STYLE_B_IMAGE=https://your-domain/styles/style_b.jpg

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
